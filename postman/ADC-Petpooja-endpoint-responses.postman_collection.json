          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"restID\": \"bw8dz5o93u\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/get-store-status",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "get-store-status"
          ]
        },
        "description": "Same call with the Authorization header REMOVED, to show the endpoints are protected.\n\n**Before running:** open the Headers tab and untick `Authorization`.\n\n**Expected response** — HTTP 401\n```json\n{\"status\":\"failed\",\"message\":\"unauthorized\"}\n```"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('rejected without credentials (401)', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
