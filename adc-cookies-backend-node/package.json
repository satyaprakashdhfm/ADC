{
  "name": "adc-cookies-backend",
  "version": "1.0.1",
  "description": "ADC Cookies REST API — Node.js/Express port of the Spring Boot backend",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "tsc --project tsconfig.json --watch --preserveWatchOutput & node --watch dist/server.js",
    "db:create": "bash scripts/create-db.sh",
    "db:pull": "drizzle-kit pull",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "test": "npm run build && node --test tests/*.test.js",
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^9.0.1",
    "pg": "^8.13.3",
    "undici": "^7.29.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/express-serve-static-core": "^4.19.9",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24"
  }
}
