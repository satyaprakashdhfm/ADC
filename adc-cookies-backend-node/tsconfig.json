{
  /* Node 24 on Railway, ESM throughout ("type": "module").
   *
   * We COMPILE with tsc rather than leaning on Node's native type stripping. Stripping needs Node
   * >= 22.18 and a developer machine here is on 22.16, so it would break local dev — and more to
   * the point it only ERASES types, it never checks them, which is the entire reason for moving to
   * TypeScript in the first place.
   *
   * module/moduleResolution NodeNext is what lets every existing import keep its ".js" extension
   * while the file next to it is called ".ts". That is why this migration needs no import rewriting:
   * under NodeNext, "./db/index.js" resolves to db/index.ts at compile time and to the emitted
   * db/index.js at run time, which is correct in both worlds.
   */
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true,

    /* allowJs while the migration is in progress: a .ts file may import a .js one and vice versa,
       so files convert one at a time instead of in a single flag day. checkJs stays OFF — type
       errors in a file nobody has converted yet are noise, not signal. */
    "allowJs": true,
    "checkJs": false,

    "strict": true,
    /*
     * STAGED, and this is the one setting to revisit.
     *
     * strict is on, but implicit any is allowed for now. Turning it on immediately produced 303 of
     * 461 errors, and clearing them meant hand-writing `any` on parameters the compiler would infer
     * as `any` regardless — effort spent to reach the same place, with every keystroke a chance to
     * assert a WRONG type on working code. That is not a theoretical risk: doing it by hand here
     * declared a Set as an array, and only the compiler noticed.
     *
     * What is left switched on is the part that finds real defects rather than missing paperwork —
     * property access on the wrong shape, unsound narrowing, unhandled null. Those are the errors
     * that caught money defaults typed as strings.
     *
     * Tighten it per-directory once the port has settled: utils, config, db and models already pass
     * with it on.
     */
    "noImplicitAny": false,
    /* The two strict flags worth calling out, because they are the ones that find real bugs here:
       a Postgres row can always come back undefined, and a JSON column is genuinely unknown. */
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,

    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,

    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false
  },
  "include": ["src/**/*.ts", "src/**/*.js"],
  "exclude": ["node_modules", "dist", "tests", "scripts", "drizzle"]
}
